# ---------------------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------------------
# One of: anthropic | openai | ollama | litellm
# When set, this GLOBALLY overrides llm.provider in EVERY YAML config. Leave it
# commented out so each config uses its own declared provider (needed so the
# hyperspace_* litellm configs can coexist with the anthropic ones).
# AGENT_LLM__PROVIDER=anthropic

# --- Anthropic ---
# Two ways to authenticate (pick one):
#
# (A) LLM gateway / proxy — Bearer token (e.g. SAP internal gateway, the same
#     scheme Claude Code uses). If ANTHROPIC_AUTH_TOKEN is set, the agent sends
#     `Authorization: Bearer <token>` to ANTHROPIC_BASE_URL. Use gateway model
#     names in the YAML config (e.g. anthropic--claude-sonnet-latest).
# ANTHROPIC_AUTH_TOKEN=your-gateway-token
# ANTHROPIC_BASE_URL=http://localhost:6655/anthropic/
#
# (B) Direct Anthropic API — x-api-key. Use standard model names (claude-sonnet-4-6).
ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI ---
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama (local) ---
# No key needed; set base_url in the YAML config or below.
# OLLAMA_BASE_URL=http://localhost:11434

# --- LiteLLM proxy (SAP "Hyperspace" gateway) ---
# The `litellm` provider talks to a LiteLLM proxy: one OpenAI-compatible
# endpoint that fronts many backends (Azure OpenAI, Google Vertex, Bedrock, ...).
# The hyperspace_* configs (gpt-5.6-sol, gemini-3.5-flash) route through it.
# The bearer key defaults to ANTHROPIC_AUTH_TOKEN (same Hyperspace token) when
# LITELLM_API_KEY is unset, so one token covers the whole gateway.
# LITELLM_BASE_URL=http://localhost:6655/litellm/v1
# LITELLM_API_KEY=   # optional; falls back to ANTHROPIC_AUTH_TOKEN

# ---------------------------------------------------------------------------
# Web search (optional) — used by the built-in `web_search` tool when a config
# sets `web_search: true` (e.g. generic_react.yaml).
#   * With TAVILY_API_KEY set, search goes through Tavily (LLM-optimized).
#   * Without it, the tool falls back to a keyless DuckDuckGo query, so web
#     search works out of the box with no signup.
# TAVILY_API_KEY=tvly-your-key-here

# ---------------------------------------------------------------------------
# Observability — LangSmith (optional, OFF by default)
# ---------------------------------------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_your-key-here
# LANGCHAIN_PROJECT=agent-scaffold

# ---------------------------------------------------------------------------
# Observability — OpenTelemetry (optional, OFF unless you export these)
# ---------------------------------------------------------------------------
# Spans are sent to the OTel Collector already running in the kind cluster
# `kind-gardener-ai-mcp`, namespace `observability`. See docs/OBSERVABILITY.md.
# Port-forward first:
#   kubectl --context kind-gardener-ai-mcp -n observability port-forward svc/otel-collector 4318:4318
#   kubectl --context kind-gardener-ai-mcp -n observability port-forward svc/jaeger 16686:16686
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Jaeger link printed after each turn. Unset uses http://127.0.0.1:16686.
# OTEL_UI_BASE_URL=http://127.0.0.1:16686
# OTEL_AI_CAPTURE_CONTENT=false

# ---------------------------------------------------------------------------
# Demo (sap_ops) — the gardener-ai-mcp server this scaffold reuses expects
# these to be present in ITS OWN environment. When the sap_ops config launches
# gardener-ai-mcp as a subprocess, it inherits the current environment, so set
# these here if you want the demo tools to actually retrieve.
# ---------------------------------------------------------------------------
# ANTHROPIC_AUTH_TOKEN=your-hyperspace-token
# GITHUB_TOKEN=ghp_your-token
