# Google AI Studio API key. Get one at https://aistudio.google.com/apikey
# @google/adk (via @google/genai) reads GEMINI_API_KEY, with GOOGLE_API_KEY as an accepted alias.
GEMINI_API_KEY=your-key-here

# Alias — set EITHER GEMINI_API_KEY or GOOGLE_API_KEY (not required to set both).
# GOOGLE_API_KEY=your-key-here
